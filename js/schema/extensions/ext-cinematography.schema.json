{
  "$defs": {
    "CameraComponent": {
      "additionalProperties": false,
      "description": "One entity's `ext-cinematography.camera` component, parsed from\n`WorldEntity::extra` with every default applied.",
      "properties": {
        "aim": {
          "description": "Look at this world point, +Y up; absent looks down the entity's\nlocal −Z (the glTF / three.js / Bevy convention).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": [
            "array"
          ]
        },
        "aim_entity": {
          "description": "Look at this entity's origin, over `aim`, while it exists — an\nentity reference: the id in a document, a name at intake (bound\nat ingestion, rewritten at merge, like `parent`).",
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "x-entity-ref": "bindable"
        },
        "aspect_ratio": {
          "description": "Crop to this frame aspect (w/h); absent keeps the desqueezed\nsensor's.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "f_stop": {
          "description": "The f-stop.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "focal_length_mm": {
          "default": 35.0,
          "description": "The lens, mm.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "focus_distance_m": {
          "description": "Focus distance, m.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "focus_entity": {
          "description": "Focus on this entity: the focus distance is the distance to its\norigin, over `focus_distance_m`, while it exists.",
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "x-entity-ref": "bindable"
        },
        "sensor_mm": {
          "default": [
            24.89,
            18.66
          ],
          "description": "Sensor (filmback) `[w, h]`, mm.",
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "squeeze": {
          "default": 1.0,
          "description": "Anamorphic desqueeze.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "Easing": {
      "description": "Easing applied to a linear interval's normalized time.",
      "oneOf": [
        {
          "const": "linear",
          "description": "No easing.",
          "type": "string"
        },
        {
          "const": "ease_in",
          "description": "`u²`.",
          "type": "string"
        },
        {
          "const": "ease_out",
          "description": "`1 - (1-u)²`.",
          "type": "string"
        },
        {
          "const": "ease_in_out",
          "description": "Quadratic acceleration and deceleration.",
          "type": "string"
        }
      ]
    },
    "EntityBlock": {
      "additionalProperties": false,
      "description": "An entity's cinematography block: a camera, shot, and/or entity-local track.",
      "minProperties": 1,
      "properties": {
        "camera": {
          "$ref": "#/$defs/CameraComponent",
          "description": "A filmback and lens."
        },
        "shot": {
          "$ref": "#/$defs/ShotComponent",
          "description": "A setup in the shot list."
        },
        "track": {
          "$ref": "#/$defs/Track",
          "description": "One entity-local timed TRS track."
        }
      },
      "type": "object"
    },
    "Extrapolation": {
      "description": "Evaluation outside the clip.",
      "oneOf": [
        {
          "const": "hold",
          "description": "Clamp to the clip endpoint.",
          "type": "string"
        },
        {
          "const": "base",
          "description": "Return the entity's authored local transform, skipping every channel.",
          "type": "string"
        },
        {
          "const": "loop",
          "description": "Repeat the clip with Euclidean time wrapping.",
          "type": "string"
        }
      ]
    },
    "Interpolation": {
      "description": "Interpolation from one key to the next.",
      "oneOf": [
        {
          "const": "linear",
          "description": "Component-wise linear interpolation, after easing.",
          "type": "string"
        },
        {
          "const": "step",
          "description": "Hold the interval's first value until its next key.",
          "type": "string"
        }
      ]
    },
    "ShotComponent": {
      "additionalProperties": false,
      "description": "An entity's shot component, as declared on the clock.",
      "properties": {
        "description": {
          "description": "What the setup is, free text.",
          "type": [
            "string"
          ]
        },
        "in_s": {
          "description": "Setup start in seconds; must not exceed `out_s`.",
          "format": "double",
          "type": [
            "number"
          ]
        },
        "order": {
          "description": "Shot list sort key; ties break by entity id.",
          "format": "int64",
          "type": [
            "integer"
          ]
        },
        "out_s": {
          "description": "Setup end in seconds.",
          "format": "double",
          "type": [
            "number"
          ]
        },
        "scene": {
          "description": "Scene slug, free text.",
          "type": [
            "string"
          ]
        },
        "size": {
          "description": "Shot size, free text.",
          "type": [
            "string"
          ]
        }
      },
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "description": "One entity-local timed translation/rotation/scale track.",
      "properties": {
        "channels": {
          "$ref": "#/$defs/TrackChannels",
          "description": "At least one nonempty channel, with strictly increasing key times."
        },
        "clip": {
          "$ref": "#/$defs/TrackClip",
          "description": "Explicit inclusive clip; absent uses the minimum and maximum key times."
        },
        "post": {
          "$ref": "#/$defs/Extrapolation",
          "default": "hold",
          "description": "Evaluation strictly after the clip."
        },
        "pre": {
          "$ref": "#/$defs/Extrapolation",
          "default": "hold",
          "description": "Evaluation strictly before the clip."
        }
      },
      "required": [
        "channels"
      ],
      "type": "object"
    },
    "TrackChannels": {
      "additionalProperties": false,
      "description": "The three independent channels. At least one must be present and nonempty.",
      "minProperties": 1,
      "properties": {
        "rotation": {
          "description": "Intrinsic XYZ Euler degrees, interpolated without angle wrapping.",
          "items": {
            "$ref": "#/$defs/TrackKey"
          },
          "minItems": 1,
          "type": [
            "array"
          ]
        },
        "scale": {
          "description": "Component-wise scale, including zero and negative values.",
          "items": {
            "$ref": "#/$defs/TrackKey"
          },
          "minItems": 1,
          "type": [
            "array"
          ]
        },
        "translation": {
          "description": "Parent-local translation in world units/metres.",
          "items": {
            "$ref": "#/$defs/TrackKey"
          },
          "minItems": 1,
          "type": [
            "array"
          ]
        }
      },
      "type": "object"
    },
    "TrackClip": {
      "additionalProperties": false,
      "description": "A track's explicit time clip, in seconds.",
      "properties": {
        "end_s": {
          "description": "Inclusive clip end; must not precede `start_s`.",
          "format": "double",
          "type": "number"
        },
        "start_s": {
          "description": "Inclusive clip start.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s"
      ],
      "type": "object"
    },
    "TrackKey": {
      "additionalProperties": false,
      "description": "One vec3 key. Interpolation and easing govern the interval to the next key.",
      "properties": {
        "easing": {
          "$ref": "#/$defs/Easing",
          "default": "linear",
          "description": "Interval easing; linear by default and ignored by `step`."
        },
        "interpolation": {
          "$ref": "#/$defs/Interpolation",
          "default": "linear",
          "description": "Interval interpolation; linear by default."
        },
        "time_s": {
          "description": "Finite key time in seconds.",
          "format": "double",
          "type": "number"
        },
        "value": {
          "description": "Translation, intrinsic XYZ Euler degrees, or component-wise scale.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The ext-cinematography extension, version 0.4 (experimental). Everything rides under the namespaced 'ext-cinematography' key on entities: 'camera' makes an entity a camera, 'shot' makes it a setup in the shot list, and 'track' animates that entity's parent-local translation, rotation and scale. The core schema leaves room for the key (unknown fields are allowed and must-ignored); this schema pins the extension's own shape. The camera's aim_entity and focus_entity are entity references in the core sense — marked x-entity-ref here, so the generated schema/entity-refs.json carries them. Spec: spec/extensions/cinematography.md.",
  "title": "ExtCinematography",
  "type": "object"
}
