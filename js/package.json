{
  "name": "openworldformat",
  "version": "0.3.3",
  "description": "The Open World Format reference package: parse and fold a .world in pure JS, plus the reference three.js renderer.",
  "type": "module",
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./src/render.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "default": "./src/physics.js"
    },
    "./cinematography": {
      "types": "./dist/cinematography.d.ts",
      "default": "./src/cinematography.js"
    }
  },
  "files": [
    "README.md",
    "src",
    "dist"
  ],
  "scripts": {
    "test": "node --test",
    "build:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:types"
  },
  "keywords": [
    "3d",
    "world",
    "gltf",
    "scene",
    "format",
    "session",
    "crdt",
    "replay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openworldformat/openworldformat.git",
    "directory": "js"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "three": ">=0.170"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  }
}
