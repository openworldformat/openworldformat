    { "id": 20, "name": "case_b_beam",
      "transform": { "position": [0.0, 2.0, 0.0], "rotation_degrees": [30.0, 45.0, 60.0] },
      "shape": { "Cuboid": { "x": 2.0, "y": 0.3, "z": 0.3 } },
      "material": { "color": [0.3, 0.6, 0.85, 1.0], "roughness": 0.6 } },
    { "id": 21, "name": "case_b_expected_tip",
      "transform": { "position": [0.3536, 2.9268, 0.1268] },
      "shape": { "Sphere": { "radius": 0.15 } },
      "material": { "color": [1.0, 0.9, 0.2, 1.0], "roughness": 0.3 } },

    { "id": 30, "name": "case_c_parent",
      "transform": { "position": [4.0, 2.0, 0.0], "rotation_degrees": [0.0, 90.0, 0.0] } },
    { "id": 31, "name": "case_c_child", "parent": 30,
      "transform": { "position": [1.0, 0.0, 0.0], "rotation_degrees": [90.0, 0.0, 0.0] },
      "shape": { "Cuboid": { "x": 0.3, "y": 2.0, "z": 0.3 } },
      "material": { "color": [0.5, 0.85, 0.45, 1.0], "roughness": 0.6 } },
    { "id": 32, "name": "case_c_expected_tip",
