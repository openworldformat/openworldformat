                    }
                  }
                },
                {
                  "SpawnEntity": {
                    "entity": {
                      "id": 2,
                      "name": "child",
                      "parent": 3
                    }
                  }
                },
                {
                  "ModifyEntity": {
                    "id": 3,
                    "patch": {
                      "name": "batched-renamed"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "head": "{\n  \"entities\": [\n    {\n      \"id\": 1,\n      \"name\": \"main-one\"\n    },\n    {\n      \"id\": 2,\n      \"name\": \"child\",\n      \"parent\": 3\n    },\n    {\n      \"id\": 3,\n      \"name\": \"batched-renamed\"\n    }\n  ],\n  \"meta\": {\n    \"name\": \"batch\"\n  },\n  \"next_entity_id\": 4,\n  \"version\": 3\n}\n"
